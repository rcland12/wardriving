# Capture data: location history + device identifiers. Never commit.
logs/
*.kismet
*.kismet-journal
*.wiglecsv
*.pcap
*.pcapng
*.kml

# Secrets / per-device state
kismet_httpd.conf
*.apikey
wigle.txt
*.env
.secrets/
touch.json
config/wardrive.toml

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# Private working notes (plans, infra details) - local only
notes/

# Offline map data (build from OpenStreetMap with tools/build_map.py)
*.map
*.osm.pbf
*.staging.sqlite

# Dev artifacts
screenshots/
*.bak-*

# Case: sliced G-code is specific to one printer + profile (share via a Release if needed).
# Build logs (case/logs/) are covered by logs/ above.
*.gcode
